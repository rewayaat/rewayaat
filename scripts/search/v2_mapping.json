{
 "settings": {
  "index": {
   "number_of_shards": 1,
   "number_of_replicas": 0,
   "analysis": {
    "char_filter": {
     "strip_hamza": {
      "type": "mapping",
      "mappings": [
       "ʿ=>",
       "ʾ=>",
       "‘=>",
       "’=>",
       "`=>",
       "´=>",
       "ʼ=>"
      ]
     }
    },
    "filter": {
     "translit_names": {
      "type": "synonym_graph",
      "synonyms": [
       "husayn,hussain,husain,hussayn,hussein,husein",
       "hasan,hassan,hasan",
       "abdullah,abdallah,abdulla,abdalla",
       "muhammad,muhammed,mohammad,mohammed",
       "ghadir,ghadeer,ghadier",
       "sadiq,sadeeq,saadiq",
       "jafar,jaffar,jaafar",
       "ridha,rida,reza,ridah",
       "baqir,baqer",
       "kadhim,kazim,kadhem",
       "askari,askary",
       "mahdi,mehdi",
       "fatima,fatimah,fatema",
       "zahra,zahraa",
       "abbas,abas",
       "umar,omar",
       "uthman,othman",
       "aisha,ayesha",
       "zakat,zakah,zakaat",
       "salat,salah,salaat",
       "sawm,saum",
       "hajj,haj",
       "quran,koran",
       "sunnah,sunna",
       "hadith,hadeeth",
       "imam,imaam",
       "shia,shiah,shiite",
       "kufa,koofa",
       "karbala,kerbala"
      ]
     }
    },
    "analyzer": {
     "arabic_norm": {
      "tokenizer": "standard",
      "filter": [
       "lowercase",
       "decimal_digit",
       "arabic_normalization"
      ]
     },
     "english_fold": {
      "char_filter": [
       "strip_hamza"
      ],
      "tokenizer": "standard",
      "filter": [
       "lowercase",
       "asciifolding",
       "kstem"
      ]
     },
     "english_fold_search": {
      "char_filter": [
       "strip_hamza"
      ],
      "tokenizer": "standard",
      "filter": [
       "lowercase",
       "asciifolding",
       "translit_names",
       "kstem"
      ]
     }
    }
   }
  }
 },
 "mappings": {
  "properties": {
   "arabic": {
    "type": "text",
    "analyzer": "arabic_norm"
   },
   "arabic_annotated": {
    "type": "text",
    "index": false
   },
   "book": {
    "type": "keyword",
    "fields": {
     "text": {
      "type": "text",
      "analyzer": "english_fold",
      "search_analyzer": "english_fold_search"
     }
    }
   },
   "book_ar": {
    "type": "text",
    "fields": {
     "keyword": {
      "type": "keyword",
      "ignore_above": 256
     }
    },
    "analyzer": "arabic_norm"
   },
   "chapter": {
    "type": "text",
    "fields": {
     "keyword": {
      "type": "keyword",
      "ignore_above": 1024
     }
    },
    "analyzer": "english_fold",
    "search_analyzer": "english_fold_search"
   },
   "chapter_ar": {
    "type": "keyword",
    "fields": {
