String semanticMatn = ctx.containsKey("semantic_matn_source") && ctx.semantic_matn_source != null
  ? ctx.semantic_matn_source.toString()
  : "";
String semanticSignificantTerms = ctx.containsKey("semantic_significant_terms_source") && ctx.semantic_significant_terms_source != null
  ? ctx.semantic_significant_terms_source.toString()
  : "";
String semanticEnglishHint = ctx.containsKey("semantic_english_hint_source") && ctx.semantic_english_hint_source != null
  ? ctx.semantic_english_hint_source.toString()
  : "";
String ar = ctx.containsKey("arabic") && ctx.arabic != null ? ctx.arabic.toString() : "";
String text = semanticMatn != null && semanticMatn.length() > 0 ? semanticMatn : (ar == null ? "" : ar);
text = text.replace("<", " ").replace(">", " ");

String[] honorifics = new String[] {
  "عليه السلام",
  "عليهما السلام",
  "عليهم السلام",
  "صلّى الله عليه وآله",
  "صلى الله عليه وآله",
  "رحمه الله"
};
for (int i = 0; i < honorifics.length; i++) {
  text = text.replace(honorifics[i], " ");
}

while (text.contains("  ")) {
  text = text.replace("  ", " ");
}
text = text.trim();
if (text.startsWith("query:")) {
  text = text.substring(6).trim();
}
if (text.startsWith("passage:")) {
  text = text.substring(8).trim();
}

if (semanticMatn == null || semanticMatn.length() == 0) {
  int scanLimit = text.length() < 2200 ? text.length() : 2200;
  String scanText = scanLimit > 0 ? text.substring(0, scanLimit) : "";
  String[] chainCues = new String[] {
    " حدثنا ",
    " حدّثنا ",
    " حدثني ",
    " حدّثني ",
    " اخبرنا ",
    " أخبرنا ",
    " اخبرني ",
    " أخبرني ",
    " وعن ",
    " وعنه ",
    " عنه ",
    " عن ",
    " روى ",
    " سمعت "
  };

  int chainSignals = 0;
  String paddedScan = " " + scanText + " ";
  for (int i = 0; i < chainCues.length; i++) {
    String cue = chainCues[i];
    int at = paddedScan.indexOf(cue);
    while (at >= 0) {
      chainSignals += 1;
      at = paddedScan.indexOf(cue, at + cue.length());
    }
  }

  if (chainSignals >= 3) {
    String[] splitMarkers = new String[] {
      "قالت:",
      "قالت ",
      "فقالت:",
      "فقالت ",
      " قالت:",
      " قالت ",
      " فقالت:",
      " فقالت ",
      "قال:",
      "قال ",
      "فقال:",
      "فقال ",
      " قال:",
      " قال ",
      " فقال:",
      " فقال ",
      "أنه قال",
      "انه قال",
      "قلت:",
      "قلت ",
      " قلت:",
      " قلت "
    };

    int bestSplit = -1;
    for (int i = 0; i < splitMarkers.length; i++) {
      String marker = splitMarkers[i];
      int idx = text.indexOf(marker);
      while (idx >= 0 && idx < 1800) {
        int split = idx + marker.length();
        if (split > 20 && split < text.length()) {
          String trimmed = text.substring(split).trim();
          if (trimmed.length() >= 25 && (bestSplit < 0 || split < bestSplit)) {
            bestSplit = split;
          }
        }
        idx = text.indexOf(marker, idx + marker.length());
      }
    }

    if (bestSplit > 0 && bestSplit < text.length()) {
      text = text.substring(bestSplit).trim();
    }
  }
}

while (text.length() > 0) {
  if (text.startsWith(" ") || text.startsWith("-") || text.startsWith(":")
      || text.startsWith(";") || text.startsWith(",") || text.startsWith(".")
      || text.startsWith("،")) {
    text = text.substring(1).trim();
  } else {
    break;
  }
}

while (text.contains("  ")) {
  text = text.replace("  ", " ");
}

if (text.length() > 4200) {
  text = text.substring(0, 4200).trim();
}

if (semanticEnglishHint != null && semanticEnglishHint.length() > 0) {
  text = text + " || en_hint: " + semanticEnglishHint.trim();
}

if (semanticSignificantTerms != null && semanticSignificantTerms.length() > 0) {
  text = text + " || key_terms: " + semanticSignificantTerms.trim();
}

ctx.semantic_text = text.length() == 0 ? null : "passage: " + text;
